# Copy this file to .env.testing on the VPS and fill values locally.
# Do not commit .env.testing.

NODE_ENV=development
PORT=3000
API_PUBLIC_PORT=3000

DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=public
POSTGRES_USER=<set-on-vps>
POSTGRES_PASSWORD=<set-on-vps>
POSTGRES_DB=<set-on-vps>

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=<set-on-vps>
JWT_EXPIRATION_TIME=3600s

# Internal performance testing should use mock/metadata.
WINSTON_AI_MODE=mock
WINSTON_AI_API_URL=<set-only-if-running-real-limited-integration>
WINSTON_AI_TOKEN=<set-only-if-running-real-limited-integration>
PLAGIARISM_REPORT_MODE=metadata

BASE_URL=http://<vps-host-or-domain>:3000
FRONTEND_URL=http://<frontend-host-or-domain>
CORS_ORIGINS=http://<frontend-host-or-domain>,http://<vps-host-or-domain>:3000

CLOUDFLARE_R2_ENDPOINT=<set-on-vps>
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=<set-on-vps>
CLOUDFLARE_R2_ACCESS_KEY_ID=<set-on-vps>
CLOUDFLARE_R2_SECRET_ACCESS_KEY=<set-on-vps>
CLOUDFLARE_R2_PUBLIC_URL=<set-on-vps>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

ENABLE_REQUEST_LOGGING=false
TEST_USER_PASSWORD=<local-testing-only-password>
