{
  "name": "protextify-backendv2",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:email": "jest src/email/",
    "test:functional": "jest --config ./test/jest-functional.json --runInBand",
    "thesis:test:functional": "npm run test:functional",
    "k6:smoke": "k6 run tests/performance/k6/smoke.js",
    "k6:load": "k6 run tests/performance/k6/load.js",
    "k6:stress": "k6 run tests/performance/k6/stress.js",
    "k6:spike": "k6 run tests/performance/k6/spike.js",
    "k6:endurance": "k6 run tests/performance/k6/endurance.js",
    "thesis:k6:smoke": "npm run k6:smoke",
    "thesis:k6:load": "npm run k6:load",
    "thesis:k6:stress": "npm run k6:stress",
    "thesis:k6:spike": "npm run k6:spike",
    "thesis:k6:endurance": "npm run k6:endurance",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:cors": "node test-cors.js",
    "postbuild": "npm run copy:templates && npm run copy:assets",
    "copy:templates": "copyfiles -u 3 src/email/templates/* dist/email/templates",
    "copy:assets": "copyfiles -u 2 src/assets/* dist/src/assets",
    "queue:dashboard": "bull-board",
    "queue:clean": "node -e \"require('./dist/src/plagiarism/plagiarism.service.js').cleanupOldJobs()\"",
    "test:data:setup": "tsx scripts/test-data/setup-test-data.ts",
    "test:data:cleanup": "tsx scripts/test-data/cleanup-test-data.ts",
    "thesis:test:data:reset": "npm run test:data:cleanup && npm run test:data:setup",
    "db:seed": "npx prisma db seed",
    "db:reset": "npx prisma migrate reset && npx prisma db seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1043.0",
