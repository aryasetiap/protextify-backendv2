{
  "info": {
    "_postman_id": "protextify-api-functional-integration",
    "name": "Protextify API Functional & Integration Testing",
    "description": "Functional and integration API checks for the Protextify backend. This collection complements Jest/Supertest and k6. WinstonAI coverage is limited to mock/metadata flow; it does not test WinstonAI accuracy or real-provider load.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response body is valid JSON when present', function () {",
          "  const body = pm.response.text();",
          "  if (body && body.trim().length > 0) {",
          "    pm.expect(function () { pm.response.json(); }).not.to.throw();",
          "  }",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "valid_content",
      "value": "Konten API Functional dan Integration Testing backend Protextify. Teks dummy ini sengaja dibuat lebih dari seratus karakter agar valid untuk submission dan pengecekan plagiarisme mode mock."
    },
    {
      "key": "updated_content",
      "value": "Konten draft yang diperbarui melalui Postman Collection Runner atau Newman. Teks ini tetap dummy dan aman digunakan untuk pengujian fungsional endpoint update content."
    },
    {
      "key": "invalid_submission_id",
      "value": "not-a-real-submission-id"
    }
  ],
  "item": [
    {
      "name": "A. Auth",
      "item": [
        {
          "name": "Login instructor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('access token and instructor user are present', function () {",
                  "  pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.user).to.be.an('object');",
                  "  pm.expect(json.user.email).to.eql(pm.environment.get('instructor_email'));",
                  "  pm.expect(json.user.role).to.eql('INSTRUCTOR');",
                  "});",
                  "pm.environment.set('instructor_token', json.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{instructor_email}}\",\n  \"password\": \"{{test_user_password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login student",
