    {
      "name": "C. Submission Flow",
      "item": [
        {
          "name": "Create submission",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('submission is created as draft', function () {",
                  "  pm.expect(json.id).to.be.a('string');",
                  "  pm.expect(json.assignmentId).to.eql(pm.environment.get('write_assignment_id'));",
                  "  pm.expect(json.status).to.eql('DRAFT');",
                  "});",
                  "pm.environment.set('created_submission_id', json.id);",
                  "pm.environment.set('submission_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"{{valid_content}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/assignments/{{write_assignment_id}}/submissions", "host": ["{{base_url}}"], "path": ["api", "assignments", "{{write_assignment_id}}", "submissions"] }
          }
        },
        {
          "name": "Update draft content",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('draft content update returns expected fields', function () {",
                  "  pm.expect(json.id).to.eql(pm.environment.get('created_submission_id'));",
                  "  pm.expect(json.content).to.be.a('string');",
                  "  pm.expect(json.status).to.eql('DRAFT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"{{updated_content}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/submissions/{{created_submission_id}}/content", "host": ["{{base_url}}"], "path": ["api", "submissions", "{{created_submission_id}}", "content"] }
          }
        },
        {
          "name": "Submit submission",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('submission becomes SUBMITTED', function () {",
                  "  pm.expect(json.id).to.eql(pm.environment.get('created_submission_id'));",
                  "  pm.expect(json.status).to.eql('SUBMITTED');",
                  "  pm.expect(json.submittedAt).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"answers\": [8, 8, 8, 8, 8]\n}" },
            "url": { "raw": "{{base_url}}/api/submissions/{{created_submission_id}}/submit", "host": ["{{base_url}}"], "path": ["api", "submissions", "{{created_submission_id}}", "submit"] }
          }
        },
        {
          "name": "Get submission detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('submission detail has expected shape', function () {",
                  "  pm.expect(json.id).to.eql(pm.environment.get('created_submission_id'));",
                  "  pm.expect(json.status).to.eql('SUBMITTED');",
                  "  pm.expect(json.assignment).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{student_token}}" }],
            "url": { "raw": "{{base_url}}/api/submissions/{{created_submission_id}}", "host": ["{{base_url}}"], "path": ["api", "submissions", "{{created_submission_id}}"] }
          }
        },
