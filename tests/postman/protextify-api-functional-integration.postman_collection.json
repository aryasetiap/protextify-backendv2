    {
      "name": "E. Plagiarism Integration Mock",
      "description": "Run only when backend uses WINSTON_AI_MODE=mock and PLAGIARISM_REPORT_MODE=metadata.",
      "item": [
        {
          "name": "Queue stats before",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                "const json = pm.response.json();",
                "pm.test('queue stats numeric fields exist', function () { ['waiting','active','completed','failed','total'].forEach(function (key) { pm.expect(json[key]).to.be.a('number'); }); });"
              ] }
            }
          ],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{instructor_token}}" }], "url": { "raw": "{{base_url}}/api/plagiarism/queue-stats", "host": ["{{base_url}}"], "path": ["api", "plagiarism", "queue-stats"] } }
        },
        {
          "name": "Trigger check plagiarism on valid submitted submission",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('status is 200 or 201', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                "const json = pm.response.json();",
                "pm.test('trigger response has safe status shape', function () {",
                "  pm.expect(json.status).to.be.oneOf(['queued', 'processing', 'completed']);",
                "  pm.expect(json.message).to.be.a('string');",
                "});",
                "pm.environment.set('plagiarism_poll_attempt', '0');"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructor_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{base_url}}/api/submissions/{{winstonai_submission_id}}/check-plagiarism", "host": ["{{base_url}}"], "path": ["api", "submissions", "{{winstonai_submission_id}}", "check-plagiarism"] }
          }
        },
        {
          "name": "Poll/get plagiarism report",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                "const json = pm.response.json();",
                "pm.test('report response has base shape', function () {",
                "  pm.expect(json.submissionId).to.eql(pm.environment.get('winstonai_submission_id'));",
                "  pm.expect(json.status).to.be.a('string');",
                "  pm.expect(json).to.have.property('pdfReportUrl');",
                "});",
                "const terminal = ['completed', 'failed'].includes(json.status);",
                "let attempts = Number(pm.environment.get('plagiarism_poll_attempt') || '0');",
                "if (!terminal && attempts < 10) {",
                "  pm.environment.set('plagiarism_poll_attempt', String(attempts + 1));",
                "  postman.setNextRequest('Poll/get plagiarism report');",
                "} else {",
                "  pm.environment.unset('plagiarism_poll_attempt');",
                "  pm.test('mock report reaches terminal status', function () { pm.expect(json.status).to.be.oneOf(['completed', 'failed']); });",
                "  if (json.status === 'completed') {",
                "    pm.test('completed mock report has metrics but no accuracy assertion', function () {",
                "      pm.expect(json.score).to.be.a('number');",
                "      pm.expect(json.wordCount).to.be.a('number');",
                "      pm.expect(json.creditsUsed).to.be.a('number');",
                "      pm.expect(json.pdfReportUrl === null || typeof json.pdfReportUrl === 'string').to.eql(true);",
                "      pm.expect(json.detailedResults).to.be.an('object');",
                "      pm.expect(json.detailedResults.metadata.providerMode).to.eql('mock');",
                "    });",
                "  }",
                "}"
              ] }
            }
          ],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{instructor_token}}" }], "url": { "raw": "{{base_url}}/api/submissions/{{winstonai_submission_id}}/plagiarism-report", "host": ["{{base_url}}"], "path": ["api", "submissions", "{{winstonai_submission_id}}", "plagiarism-report"] } }
